{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-skills:benchmark:api:1",
  "title": "Finance public benchmarks api",
  "$defs": {
    "Datasets": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "stream": {
                "const": "public-benchmark"
              },
              "series_count": {
                "type": "integer",
                "minimum": 0
              },
              "snapshot_count": {
                "type": "integer",
                "minimum": 0
              },
              "snapshots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
                    },
                    "retrieved_at": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "format": "date-time"
                    },
                    "data_class": {
                      "enum": [
                        "public",
                        "synthetic"
                      ]
                    },
                    "observation_count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "retrieved_at",
                    "data_class",
                    "observation_count"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 500
              }
            },
            "required": [
              "id",
              "title",
              "version",
              "stream",
              "series_count",
              "snapshot_count",
              "snapshots"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "data",
        "count"
      ],
      "additionalProperties": false
    },
    "SeriesResponse": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "series": {
          "$ref": "#/$defs/Series"
        },
        "available_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
              },
              "retrieved_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "format": "date-time"
              },
              "data_class": {
                "enum": [
                  "public",
                  "synthetic"
                ]
              },
              "observation_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "retrieved_at",
              "data_class",
              "observation_count"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
        }
      },
      "required": [
        "dataset_id",
        "series",
        "available_snapshots"
      ],
      "additionalProperties": false
    },
    "ObservationsResponse": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "series": {
          "$ref": "#/$defs/Series"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "date-time"
        },
        "data_class": {
          "enum": [
            "public",
            "synthetic"
          ]
        },
        "vintage_status": {
          "enum": [
            "known-at-cutoff",
            "explicit-snapshot",
            "latest-available"
          ]
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "refresh_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefreshStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 500
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        }
      },
      "required": [
        "dataset_id",
        "series",
        "snapshot_id",
        "retrieved_at",
        "data_class",
        "vintage_status",
        "as_of",
        "freshness",
        "refresh_status",
        "data",
        "pagination",
        "coverage"
      ],
      "additionalProperties": false
    },
    "SnapshotResponse": {
      "type": "object",
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "required": [
        "snapshot"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "code"
      ],
      "additionalProperties": false
    },
    "Series": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "provider_series_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "uri",
          "pattern": "^https://"
        },
        "download_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "uri",
          "pattern": "^https://"
        },
        "geography": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "frequency": {
          "enum": [
            "daily",
            "monthly"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "base_currency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "quote_currency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "index_base": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "seasonal_adjustment": {
          "enum": [
            "not-applicable",
            "original",
            "seasonally-adjusted"
          ]
        },
        "series_kind": {
          "enum": [
            "original",
            "derived"
          ]
        },
        "access": {
          "enum": [
            "keyless-api",
            "official-file",
            "credentialed-api",
            "project-calculation"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "adapter_status": {
          "enum": [
            "live-validated",
            "parser-validated",
            "rights-gated",
            "requires-configuration",
            "needs-source-validation"
          ]
        },
        "freshness_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3660
        },
        "rights": {
          "type": "object",
          "properties": {
            "redistribution": {
              "enum": [
                "permitted",
                "permission-required",
                "unverified",
                "restricted"
              ]
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "terms_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "format": "uri",
              "pattern": "^https://"
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "checked_on": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "format": "date"
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "redistribution",
            "license",
            "terms_url",
            "attribution",
            "checked_on",
            "notes"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "title",
        "provider",
        "provider_series_id",
        "source_id",
        "source_url",
        "download_url",
        "geography",
        "frequency",
        "unit",
        "currency",
        "base_currency",
        "quote_currency",
        "index_base",
        "seasonal_adjustment",
        "series_kind",
        "access",
        "adapter",
        "adapter_status",
        "freshness_days",
        "rights",
        "notes"
      ],
      "additionalProperties": false
    },
    "Observation": {
      "type": "object",
      "properties": {
        "series_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "provider_series_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "source_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "uri",
          "pattern": "^https://"
        },
        "observation_period": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}(?:-\\d{2})?$"
        },
        "period_start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "date"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "geography": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "index_base": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "frequency": {
          "enum": [
            "daily",
            "monthly"
          ]
        },
        "seasonal_adjustment": {
          "enum": [
            "not-applicable",
            "original",
            "seasonally-adjusted"
          ]
        },
        "release_date": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "date-time"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "origin": {
          "enum": [
            "original",
            "derived",
            "synthetic"
          ]
        },
        "period_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "observation_status": {
          "enum": [
            "published",
            "provisional",
            "revised",
            "synthetic"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "series_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
              },
              "observation_period": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
              }
            },
            "required": [
              "series_id",
              "observation_period",
              "snapshot_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "transformation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "formula": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "id",
                "version",
                "formula"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "series_id",
        "provider",
        "provider_series_id",
        "source_id",
        "source_url",
        "observation_period",
        "period_start",
        "period_end",
        "value",
        "unit",
        "geography",
        "currency",
        "index_base",
        "frequency",
        "seasonal_adjustment",
        "release_date",
        "release_at",
        "retrieved_at",
        "snapshot_id",
        "origin",
        "period_completeness",
        "observation_status",
        "inputs",
        "transformation"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "series_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "status": {
          "enum": [
            "available",
            "no-observations"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "first_period": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "last_period": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      },
      "required": [
        "series_id",
        "status",
        "count",
        "first_period",
        "last_period"
      ],
      "additionalProperties": false
    },
    "Freshness": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "within-policy",
            "stale",
            "no-observations"
          ]
        },
        "observation_age_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retrieval_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "observation_age_days",
        "retrieval_age_days",
        "max_age_days"
      ],
      "additionalProperties": false
    },
    "Pagination": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "offset",
        "limit",
        "total",
        "next_offset"
      ],
      "additionalProperties": false
    },
    "RefreshStatus": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "attempted_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "date-time"
        },
        "status": {
          "enum": [
            "succeeded",
            "fetch-failed",
            "validation-failed",
            "rights-blocked",
            "configuration-required"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "provider",
        "attempted_at",
        "status",
        "code",
        "snapshot_id"
      ],
      "additionalProperties": false
    },
    "Snapshot": {
      "title": "Finance public benchmarks snapshot",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,119}$"
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "date-time"
        },
        "data_class": {
          "enum": [
            "public",
            "synthetic"
          ]
        },
        "knowledge_basis": {
          "const": "retrieval-time"
        },
        "capture_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Series"
          },
          "maxItems": 1000,
          "minItems": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "maxItems": 100000
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Coverage"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "schema_version",
        "id",
        "dataset_id",
        "dataset_version",
        "retrieved_at",
        "data_class",
        "knowledge_basis",
        "capture_method",
        "series",
        "observations",
        "coverage"
      ],
      "additionalProperties": false
    }
  }
}
