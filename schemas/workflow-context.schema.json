{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-skills:workflow:context:1",
  "title": "Finance workflow context contract",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "scenario": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "unitScale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
    },
    "signMultiplier": {
      "enum": [
        -1,
        1
      ]
    },
    "stream": {
      "enum": [
        "approved_internal_figures",
        "internal_workflow_status",
        "public_benchmarks"
      ]
    },
    "sourceSnapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "working",
            "approved",
            "submitted",
            "observed"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "version",
        "asOf",
        "kind",
        "locator"
      ],
      "additionalProperties": false
    },
    "requestedOutput": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    }
  },
  "required": [
    "schemaVersion",
    "workflow",
    "period",
    "cutoff",
    "scenario",
    "version",
    "entities",
    "basis",
    "currency",
    "unitScale",
    "signMultiplier",
    "stream",
    "sourceSnapshot",
    "requestedOutput"
  ],
  "additionalProperties": false,
  "description": "Runtime context supplied in the approved environment. Different streams cannot fill one another. Amounts normalize to base currency units using unitScale and signMultiplier; no automatic FX conversion."
}
